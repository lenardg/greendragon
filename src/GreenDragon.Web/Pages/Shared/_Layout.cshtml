@inject GreenDragon.Web.Localization.UiText Text
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Uncial+Antiqua&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="site-header">
        <h1 class="wordmark" id="portal-title">@Text["app.name"]</h1>
        <label class="theme-label">
            @Text["theme.label"]
            <select id="theme">
                <option value="system">@Text["theme.system"]</option>
                <option value="light">@Text["theme.light"]</option>
                <option value="dark">@Text["theme.dark"]</option>
            </select>
        </label>
    </header>
    <main>@RenderBody()</main>
    <footer>@Text["footer.powered"] <a href="https://github.com/amp64/openphonos">OpenPhonos</a></footer>
</body>
</html>
